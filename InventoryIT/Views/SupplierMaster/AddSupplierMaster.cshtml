
<style>
	body {
		background-color: #1b4e72bd;
	}

	.mt-4 {
		margin-top: 5.5rem !important;
	}

	.bg-warning {
		background-color: #4268a1 !important;
	}

</style>
@{
	ViewData["Title"] = "Product Supplier Details";
}

<div class="container mt-4">
	<div class="card">
		<div class="card-header bg-warning text-white d-flex justify-content-between">
			<h4>PRODUCT SUPPLIER DETAILS</h4>
			<a href="/SpareSupplier/Index" class="btn btn-dark">RETURN TO VIEW</a>
		</div>
		<div class="card-body bg-light">
			<form action="AddSupplierMaster" method="post">
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">*Supplier Name :</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" placeholder="Enter Supplier Name" id="txtsuppliername" name="SupplierName">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">*Address :</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" placeholder="Enter Address" id="txtsupplieraddress" name="Address">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Contact Person :</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" placeholder="Enter Contact Person" id="txtsuppliercontactperson" name="ContactPerson">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">SupplierGSTCertificate:</label>
					<div class="col-sm-10">
						<input type="file" class="form-control" name="SupplierGstCertificate">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Pin No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" placeholder="Enter phone no" id="txtsupplierphoneno" name="PinNo">
					</div>
					<label class="col-sm-1 col-form-label text-end">GST No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" placeholder="Enter GST No" id="txtgstno" name="GstNo">
					</div>
					<label class="col-sm-1 col-form-label text-end">*City :</label>
					<div class="col-sm-3 d-flex">
						<select name="CityId" id="CityId" class="form-control">
							<option value="" disabled selected>Select city</option>
							@foreach (var city in ViewBag.MastCities)
							{
								<option value="@city.Value">@city.Text</option>
							}
						</select>
						<button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#cityModal">+</button>
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">State :</label>
					<div class="col-sm-2">
						<select name="StateId" id="StateId" class="form-control">
							<option value="" disabled selected>Select state</option>
							@foreach (var state in ViewBag.MastStates)
							{
								<option value="@state.Value">@state.Text</option>
							}
						</select>
					</div>
					<label class="col-sm-2 col-form-label text-end">Mobile No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" placeholder="Enter Mobile No" id="txtsuppliermobileno" name="MobileNo">
					</div>
					<label class="col-sm-2 col-form-label text-end">Phone No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" placeholder="Enter Phone No" id="txtsupplieralternateno" name="PhoneNo">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Email ID :</label>
					<div class="col-sm-10">
						<input type="email" class="form-control" id="txtsupplieremail" placeholder="Enter Email ID" name="EmailId">
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Website :</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" placeholder="Enter Website" id="txtsupplierwebsite" name="Website">
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="reset" class="btn btn-primary">Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>

<!-- City Modal -->
<div class="modal fade" id="cityModal" tabindex="-1" aria-labelledby="cityModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="cityModalLabel">City Details</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form>
					<div class="mb-3">
						<label class="form-label">* City Name :</label>
						<input type="text" class="form-control" id="txtcityname" placeholder="Enter City Name">
					</div>
					<div class="mb-3">
						<label class="form-label">* State Name :</label>
						<select class="form-control">
							<option>-- State Name --</option>
						</select>
					</div>
					<div class="text-center">
						<button type="submit" class="btn btn-success">Save</button>
						<button type="button" class="btn btn-dark" data-bs-dismiss="modal">Close</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>


