<!-- DataTables CSS -->
 <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">



<div class="container mt-4">
	<div class="panel">
		<div class="row uniq">
			<div class="col-md-6">
				<h4 class="title">SUPPLIER MASTER</h4>
			</div>

			<div class="col-md-6 text-end">
				<a href="/SupplierMaster/AddSupplierMaster" class="btn btn-light">
					ADD NEW SUPPLIER MASTER
				</a>
			</div>
		</div>

		<div class="table-container">
			<table class="table" id="myTable">
				<thead>
					<tr>
						<th class="srno">SR.No</th>
						<th>Supplier Name</th>
						<th>Mobile No</th>
						<th>City</th>
						<th>Address</th>
						<th>Actions</th>
					</tr>
				</thead>
				<thead class="search-row">
					<tr>
						<th><input type="hidden" placeholder="search sr.no"></th>
						<th><input type="text" placeholder="search supplier name"></th>
						<th><input type="text" placeholder="search mobile no"></th>
						<th><input type="text" placeholder="search cityid"></th>
						<th><input type="text" placeholder="search Address"></th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
</div>


@section Scripts {
	<!-- Load jQuery First -->
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

	<!-- Load DataTables After jQuery -->
	<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

	<script>
		$(document).ready(function () {
			if (!$.fn.DataTable) {
				console.error("DataTables library is not loaded!");
				return;
			}

			if ($("#myTable").length) {
				var table = $('#myTable').DataTable({
					"processing": true,
					"serverSide": false,
					"ajax": {
						"url": "/SupplierMaster/GetSupplier",
						"type": "GET",
						"datatype": "json",
						"dataSrc": function (json) {
							console.log(json);
							return json.data || [];
						}
					},
					"columns": [
						{ "data": "suppId" },
						{ "data": "supplierName" },
						{ "data": "mobileNo" },
						{ "data": "cityId" },
						{ "data": "address" },
						{
							"data": "suppId",
							"orderable": false,
							"searchable": false,
							"render": function (data, type, row) {
								return `<a href='/ItemSetup/Edit/${data}' class='action-icons'><i class='fa fa-edit'></i></a>
												<a href='/ItemSetup/Delete/${data}' class='action-icons'><i class='fa fa-trash'></i></a>`;
							}
						}
					]
				});

				$('.search-row input').on('keyup change', function () {
					var columnIndex = $(this).parent().index();
					table.column(columnIndex).search(this.value).draw();
				});

			} else {
				console.error("Table #myTable not found!");
			}
		});
	</script>
}

 


