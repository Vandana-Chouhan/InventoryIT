<div class="container mt-4">
	<div class="card">
		<div class="heade">
			<h4>ITEM UNIT DETAILS</h4>
			<a href="/ItemUnit/ItemUnitDataTable" class="btn btn-light">RETURN TO VIEW</a>
		</div>
		<div class="card-body">
			<form asp-action="AddItemUnit" method="post" asp-controller="ItemUnit" id="additemUnitforms">
				<div class="row">
					<div class="form-group">
						<label for="ItemUnitName">Item Unit Name:</label>
						<input class="form-control" name="ItemUnitName" required>
						<span class="text-danger"></span>
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
					<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
	const form = document.getElementById("additemUnitforms");
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		Swal.fire({
				title: "Are you sure?",
				text: "Create this ItemUnit!",
				imageUrl: '/assets/img/alert.png',
				imageHeight: "100px",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, Create it!"
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: "Created!",
						text: "ItemUnit has been created successfully.",
						icon: "success",
						timer: 2000,
						showConfirmButton: false
					}).then(() => {
						form.submit();
					});
				}
			});
		});
</script>