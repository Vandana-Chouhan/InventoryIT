<script>
	$(document).ready(function () {
		$("#loadItemType").click(function (e) {
			e.preventDefault();
			$.get("@Url.Action("AddItemType", "ItemType")", function (data) {
				$("#partialContent").html(data);
			});
		});
	});
</script>
