    .dropdown-content {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: #f9f9f9;
        min-width: 160px;
        box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
        z-index: 9999;
        padding: 0;
    }

        .dropdown-content a {
            display: block; /* Ensures all links are in a single column */
            padding: 12px 16px;
            text-decoration: none;
            color: black;
            text-align: left;
            white-space: nowrap;
            width: 100%; /* Makes sure links are in a single line */
        }

            .dropdown-content a:hover {
                background-color: #ddd;
            }


    /* Show dropdown when active */
    .show {
        display: block;
    }


