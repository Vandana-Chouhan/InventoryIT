<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/InventoryIT.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/layout.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
	<style>
		.fixed-top {
			background-color: white;
		}

		footer {
			background-color: white;
		}

		.d-none {
			color: #fff;
		}

		.nav {
			background-color: #004864;
			padding: 10px;
			height: 50px;
		}

		a[b-5vlargifs5] {
			color: white;
		}

		.items {
			font-size: 20px;
			font-weight: bold;
		}

		.nav-item ul li a {
			text-decoration: none;
			color: black;
			display: block;
			padding: 10px;
			font-size: 16px;
		}
	</style>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark px-3" style="background-color:#004864;">
			<!-- Left Side: Company Logo + Name -->
			<div class="d-flex align-items-center me-auto">
				<img src="~/assets/img/logo.png" alt="Logo" width="40" height="40" class="rounded-circle me-2">
				<span class="fw-bold text-white">FSP TECHNOLOGY</span>
			</div>
			<ul class="nav">
				<li class="nav-item items">
					<a href="@Url.Action("Inventory", "MasterSetup")" class="nav-link">Dashboard</a>
				</li>
				<li class="nav-item items">
					<a href="#" class="nav-link">Master Setup</a>
					<ul>
						<li><a href="@Url.Action("ShowMastCompDataTable", "MastComp")" class="dropdown-item">Company Setup</a></li>
						<li><a href="@Url.Action("ShowMastBranchDataTable", "MastBranch")" class="dropdown-item">Branch Setup</a></li>
						<li><a href="@Url.Action("ShowFinanYearDataTable", "FinancialYear")" class="dropdown-item">Financial Year</a></li>
						<li><a href="@Url.Action("CountryDataTab", "MastCountry")" class="dropdown-item">Country Setup</a></li>
						<li><a href="@Url.Action("StateDataTab", "MastState")" class="dropdown-item">State Setup</a></li>
						<li><a href="@Url.Action("CityDataTab", "MastCity")" class="dropdown-item">City Setup</a></li>
						<li><a href="@Url.Action("AddUserMaster", "UserMaster")" class="dropdown-item">User Setup</a></li>
					</ul>
				</li>
				<li class="nav-item items">
					<a href="#" class="nav-link" id="purchaseMgmtLink">Purchase Mgmt</a>
					<ul>
						<li><a href="@Url.Action("MasterDataCard", "MasterData")" class="dropdown-item">Master Data</a></li>
						<li><a href="@Url.Action("ShowTranctionCards", "PurchaseMgmt")" class="dropdown-item">Transactions</a></li>
						<li class="has-child">
							<a class="dropdown-item">Reports</a>
							<ul class="child-menu">
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Material Reqeust Register</a></li>
								<li><a href="@Url.Action("ItemUnit", "ItemSetup")" class="dropdown-item">Purchase Order Register</a></li>
								<li><a href="@Url.Action("ItemCompany", "ItemSetup")" class="dropdown-item">Goods Reciept Register</a></li>
								<li><a href="@Url.Action("ItemCatagory", "ItemSetup")" class="dropdown-item">Item Stock Register</a></li>
								<li><a href="@Url.Action("ItemSubCatagory", "ItemSetup")" class="dropdown-item">Item Reorder Report</a></li>
								<li><a href="@Url.Action("ItemSubCatagory", "ItemSetup")" class="dropdown-item">Item Wise Issue </a></li>
								<li><a href="@Url.Action("ItemSubCatagory", "ItemSetup")" class="dropdown-item">Supplier Wise Item Register</a></li>
							</ul>
						</li>
					</ul>
				</li>
				<li class="nav-item items">
					<a href="#" class="nav-link">Client Mgmt</a>
					<ul>
						<li class="has-child">
							<a class="dropdown-item">Master Data</a>
							<ul class="child-menu">
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Client Master</a></li>
							</ul>
						</li>
						<li class="has-child">
							<a class="dropdown-item">Transactions</a>
							<ul class="child-menu">
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Client Order Entry</a></li>
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Client Materials Request</a></li>
							</ul>
						</li>
						<li class="has-child">
							<a class="dropdown-item">Reports</a>
							<ul class="child-menu">
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Client Order Register</a></li>
								<li><a href="@Url.Action("ItemType", "ItemSetup")" class="dropdown-item">Client Wise Wrder Material Supplied</a></li>
							</ul>
						</li>
					</ul>
				</li>
				<li class="nav-item items">
					<a href=" @Url.Action("Inventory", "MasterSetup")" class="nav-link">Stores</a>
				</li>
				<li class="nav-item items">
					<a href="/WarehouseArea/ShowWarehousecards" class="nav-link" id="purchaseMgmtLink">Warehouse</a>
				</li>
				<!-- Profile Dropdown Aligned to Right -->
				<ul class="navbar-nav ms-auto" style="margin-top: -10px;">
					<li class="nav-item dropdown pe-3">
						<a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
							<img src="~/assets/img/messages-3.jpg" alt="Profile" class="rounded-circle" width="30">
							<span class="d-none d-md-block dropdown-toggle ps-2">InventoryIT</span>
						</a>
						<ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item d-flex align-items-center" href="#">
									<i class="bi bi-person"></i>
									<span>My Profile</span>
								</a>
							</li>
							<li><hr class="dropdown-divider"></li>
							<li>
								<a class="dropdown-item d-flex align-items-center" href="/MasterSetup/Login">
									<i class="bi bi-box-arrow-right"></i>
									<span>Sign Out</span>
								</a>
							</li>
						</ul>
					</li>
				</ul>
			</ul>
		</nav>
		<h4 style="background-color:white;text-align:center; color:black;font-size:15px; font-family:Arial;">
			You are currently working in:
			@Context.Session.GetString("CompanyName")/
			@Context.Session.GetString("BranchName")/
			@Context.Session.GetString("FinancialYear")
		</h4>
	</header>
	<div class="container">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>
	<footer class="border-top footer text-Black">
		Design & Developed By |<b>Aanshi Solutions</b>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>