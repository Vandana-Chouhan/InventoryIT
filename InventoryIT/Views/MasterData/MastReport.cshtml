        }

        /* Print styles */
        @@media print {
            body * {
                visibility: hidden;
            }

            .print-area, .print-area * {
                visibility: visible;
            }

            .print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
            }

            .print-btn {
                display: none;
            }
        }

        .print-btn {
            margin-bottom: 10px;
            padding: 8px 15px;
            font-size: 21px;
            color: blue;
            border: none;
            cursor: pointer;
            background-color: white;
        }

