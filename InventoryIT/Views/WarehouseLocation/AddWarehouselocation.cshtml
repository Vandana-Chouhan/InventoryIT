
<head>
    <link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

    <div class="container mt-4">
        <div class="ard">
            <div class="heade">
                <h4>WAREHOUSE LOCATION DETAILS</h4>
                <a href="/Warehouse/Index" class="btn btn-dark">RETURN TO VIEW</a>
            </div>

            <div class="card-body">
                <form action="/Warehouse/Save" method="post">
                    <div class="row mb-2">
                        <label class="col-sm-3 col-form-label text-end">
                            <span class="text-danger">*</span> Warehouse Location Name:
                        </label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" name="WarehouseLocationName" required>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success">Save</button>
                        <button type="reset" class="btn btn-primary">Refresh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>