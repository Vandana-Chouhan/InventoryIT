
<head>
	@* <style>
		.mt-3 {
			margin-top: 26rem !important;
		}
	</style> *@
	<link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
	<div class="ard">
		<div class="heade">
			<h4>WAREHOUSE LOCATION DETAILS</h4>
			<a href="/WarehouseLocation/warehouseLocaDataTab" class="btn btn-light">RETURN TO VIEW</a>
		</div>
		<div class="card-body">
			<form action="AddWarehouselocation" method="post">
				@if (TempData["SuccessMessage"] != null && !Context.Request.Query.ContainsKey("reset"))
				{
					<div class="alert alert-success">
						@TempData["SuccessMessage"]
					</div>
				}
				<div class="row mb-2" style="margin-top:30px;">
					<label class="col-sm-3 col-form-label txt-end">
						<span class="text-danger">*</span> Warehouse Location Name:
					</label>
					<div class="col-sm-9">
						<input type="text" class="form-control" name="WarehouseName" required>
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
					<button type="reset" onclick="window.location.href = window.location.href + '?reset=true';" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
