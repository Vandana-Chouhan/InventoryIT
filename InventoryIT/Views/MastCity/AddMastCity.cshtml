
<html>
<head>
    <link href="~/css/countrystatecity.css" rel="stylesheet" />

</head>
<body>
    <div class="container mt-4">
        <div class="card shadow p-3">
            <div class="card-header text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">CITY DETAILS</h4>
                <a href="/MastCity/CityDataTab" class="btn btn-light btn-sm fw-bold" style="background-color: black; color: #f6f9ff; font-size: 14px; font-weight: bold; padding: 5px;">
                    RETURN TO VIEW
                </a>
            </div>
            <div class="card-body">
                <form asp-action="AddMastCity" method="post" class="d-flex flex-column align-items-center">

                    <div class="col-md-8">
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">State Name:</label>
                            <div class="col-sm-8">
                                <select name="StateId" class="form-control" required>
                                    <option value="" disabled selected>Select State Name</option>
                                    @foreach (var state in ViewBag.MastStates)
                                    {
                                        <option value="@state.Value">@state.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">City Name:</label>
                            <div class="col-sm-8">
                                <input type="text" id="CityName" class="form-control" name="CityName" required>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">City Short Name:</label>
                            <div class="col-sm-8">
                                <input type="text" id="CityShortName" class="form-control" name="CityShortName" required>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">PIN Code:</label>
                            <div class="col-sm-8">
                                <input type="text" id="PinCode" class="form-control" name="PinCode" required>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
                        <button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
