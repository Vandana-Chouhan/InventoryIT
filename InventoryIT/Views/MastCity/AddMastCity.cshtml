<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="AddMastCity" method="post">
		<div class="panel">
			<div class="header">
				<h5>City Details</h5>
				<a href="/CompanyMaster/Index" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
					RETURN TO VIEW
				</a>
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="StateId">State Name:</label>
				<select name="StateId" class="input-small" required>
					<option value="" disabled selected>Select State Name</option>
					@foreach (var state in ViewBag.MastStates)
					{
						<option value="@state.Value">@state.Text</option>
					}
				</select>
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="CityName">City Name:</label>
				<input type="text" id="CityName" class="input-small" name="CityName" required><br />
			</div>
			
			<div class="form-group">
				<span class="required">*</span><label for="CityShortName">City Short Name:</label>
				<input type="text" id="CityShortName" class="input-small" name="CityShortName" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="PinCode">PIN Code:</label>
				<input type="text" id="PinCode" class="input-small" name="PinCode" required><br />
			</div>
			<div class="text-center mt-3">
				<button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
				<button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
			</div>
		</div>
	</form>
</body>
</html>