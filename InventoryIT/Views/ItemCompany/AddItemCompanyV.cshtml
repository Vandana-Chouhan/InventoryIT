<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="AddItemCompany" method="post">
		<div class="panel">
			<div class="header">
				<h5>Item Company Details</h5>
				<input type="button" id="return-to-view" value="Return to View" />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="ItemCompanyName">Item Company Name:</label>
				<input type="text" id="ItemCompanyName" class="input-small" name="ItemCompanyName" required><br />
			</div>
			<div class="form-group form-group-flex">
				<input type="submit" id="Save" value="Save" />
				<input type="button" id="Refresh" value="Refresh" />
			</div>
		</div>
	</form>
</body>
</html>