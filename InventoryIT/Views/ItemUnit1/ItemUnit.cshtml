<head>
    <link rel="stylesheet" href="~/ItemSetup/style.css" asp-append-version="true" />
</head> 

<div class="container mt-4">
    <div class="card">
        <div class="heade">
            <h4>ITEM UNIT DETAILS</h4>
            <a asp-action="Index" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="card-body">
            <form asp-action="ItemUnit" method="post">
                <div class="row">
                    <div class="form-group" style="margin-top: 13px;">
                        <label class="text-end" for="ItemUnitName">Item Unit Name:</label>
                        <input  class="form-control" required>
                        <span  class="text-danger"></span>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
                    <button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>