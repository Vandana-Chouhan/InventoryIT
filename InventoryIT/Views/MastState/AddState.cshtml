
<html>
<head>
 
    <link href="~/css/countrystatecity.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow p-3">
            <div class="card-header text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">STATE DETAILS</h4>
                <a href="/MastState/StateDataTab" class="btn btn-light btn-sm fw-bold" style="background-color: black; color: #f6f9ff; font-size: 14px; font-weight: bold; padding: 5px;">
                    RETURN TO VIEW
                </a>
            </div>
            <div class="card-body">
                <form asp-action="AddState" method="post" class="d-flex flex-column align-items-center">

                    <div class="col-md-8">
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">Country Name:</label>
                            <div class="col-sm-8">
                                <select name="CountryId" class="form-control" required>
                                    <option value="" disabled selected>Select Country Name</option>
                                    @foreach (var country in ViewBag.MastCountries)
                                    {
                                        <option value="@country.Value">@country.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">State Name:</label>
                            <div class="col-sm-8">
                                <input type="text" id="StateName" class="form-control" name="StateName" required>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <label class="col-sm-4 col-form-label text-end">State Short Name:</label>
                            <div class="col-sm-8">
                                <input type="text" id="StateShortName" class="form-control" name="StateShortName" required>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
                        <button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
