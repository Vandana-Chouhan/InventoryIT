<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="AddState" method="post">
		<div class="panel">
			<div class="header">
				<h5>State Details</h5>
				<a href="/CompanyMaster/Index" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
					RETURN TO VIEW
				</a>
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="CountryId">Country Name:</label>
				<select name="CountryId" class="input-small" required>
					<option value="" disabled selected>Select Country Name</option>
					@foreach (var country in ViewBag.MastCountries)
					{
						<option value="@country.Value">@country.Text</option>
					}
				</select>
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="ItemSubCatagory">State Name:</label>
				<input type="text" id="StateName" class="input-small" name="StateName" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="StateShortName">State Short Name:</label>
				<input type="text" id="StateShortName" class="input-small" name="StateShortName" required><br />
			</div>
			<div class="text-center mt-3">
				<button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
				<button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
			</div>
		</div>
	</form>
</body>
</html>