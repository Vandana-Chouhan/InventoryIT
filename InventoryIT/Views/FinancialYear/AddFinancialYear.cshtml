<head>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<link rel="stylesheet" href="~/Company/style.css" asp-append-version="true" />
</head>
<script>
	// Function to handle Financial Year From input and auto-fill other fields
	function updateFinancialYearFields() {
		var financialYearFrom = document.getElementById("FinancialYearFrom").value;
		var financialYearToField = document.getElementById("FinancialYearTo");
		var financialYearNameField = document.getElementById("FinancialYearName");

		if (financialYearFrom) {
			// Increment the 'Financial Year From' value by 1 for the 'Financial Year To' field
			var financialYearTo = parseInt(financialYearFrom) + 1;
			financialYearToField.value = financialYearTo;

			// Concatenate 'Financial Year From' and 'Financial Year To' for the 'Financial Year Name'
			financialYearNameField.value = financialYearFrom + financialYearTo;
		} else {
			// Clear the fields if 'Financial Year From' is empty
			financialYearToField.value = '';
			financialYearNameField.value = '';
		}
	}
</script>
<div class="container mt-4">
	<div class="cad">
		<div class="card-heade text-white d-flex justify-content-between" style="border-radius:5px;height:42px;">
			<h4 style="font-size: 20px;
                font-weight: bold;">
				FINANCIAL YEAR DETAILS
			</h4>
			<a href="/FinancialYear/ShowFinanYearDataTable" class="btn btn-light" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
				RETURN TO VIEW
			</a>
		</div>
		<div class="card-body">
			<form asp-action="AddFinancialYear" asp-controller="FinancialYear" method="post" style="background-color: white;" id="addfinancialyearforms">
				@if (TempData["Failed"] != null)
				{
					<div class="alert alert-danger alert-dismissible fade show" role="alert">
						@TempData["Failed"]
						<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
					</div>
				}
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Select Compony:</label>
					<div class="col-sm-10">
						<select class="form-control" name="CompId" id="ddlCompanyName" required>
							<option value="" disabled selected>Select Company</option>
							@foreach (var company in ViewBag.MastComps)
							{
								<option value="@company.Value">@company.Text</option>
							}
						</select>
					</div>
				</div>
				<div class="row mb-2">
					<label for="txtFinancialYearFrom" class="col-sm-2 col-form-label text-end">Start From 1/April/20::</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" name="FinancialYearFrom" id="FinancialYearFrom" required oninput="updateFinancialYearFields()">
					</div>
				</div>
				<div class="row mb-2">
					<label for="txtFinancialYearTo" class="col-sm-2 col-form-label text-end">End on 31/March/20:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="FinancialYearTo" name="FinancialYearTo" required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Financial Year Name:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="FinancialYearName" name="FinancialYearName" required>
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
					<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
	const form = document.getElementById("addfinancialyearforms");
		form.addEventListener("submit", function (event) {
			event.preventDefault();
        Swal.fire({
				title: "Are you sure?",
				text: "Create this FinancialYear!",
				imageUrl: '/assets/img/alert.png',
				imageHeight: "100px",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, Create it!"
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: "Created!",
						text: "FinancialYear has been created successfully.",
						icon: "success",
						timer: 2000,
						showConfirmButton: false
					}).then(() => {
						form.submit();
					});
				}
			});
		});
</script> 