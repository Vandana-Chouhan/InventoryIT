<head>
    <link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
    <div class="ard">
        <div class="heade">
            <h4>Warehouse Rack Details</h4>
            <a href="/WarehouseRack/Index" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="card-body">
            <form action="/WarehouseRack/Save" method="post">
                <div class="form-group">
                    <label for="ddlWarehouseLocation">Warehouse Location:</label>
                    <select class="form-control" name="WarehouseLocationName" id="ddlWarehouseLocation" required>
                        <option value="" disabled selected>Select Location</option>
                        <option value="Indore">Location1</option>
                        <option value="Pune">Location2</option>
                        <option value="Dhar">Location3</option>
                        <option value="Mumbai">Location4</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="ddlWarehouseArea">Warehouse Area :</label>
                    <select class="form-control" name="WarehouseAreaName" id="ddlWarehouseArea" required>
                        <option value="" disabled selected>Select Area</option>
                        <option value="Indore">Area1</option>
                        <option value="Pune">Area2</option>
                        <option value="Dhar">Area3</option>
                        <option value="Mumbai">Area4</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="txtWarehouseRack">Warehouse Rack:</label>
                    <input type="text" class="form-control" name="WarehouseRackName" id="txtWarehouseRack" required>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="reset" class="btn btn-primary">Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>