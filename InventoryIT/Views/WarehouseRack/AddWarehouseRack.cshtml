<html>
<head>
	<style>
		div:where(.swal2-container).swal2-center > .swal2-popup {
			grid-column: 2;
			grid-row: 2;
			place-self: center center;
			width: 35%;
		}
	</style>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
	<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script> <!-- Load jQuery -->
	<script type="text/javascript">
		// Wait until the DOM is fully loaded before running the script
		$(document).ready(function () {
			// When the location dropdown changes, update the areas dropdown.
			$('#WarehouseLocId').change(function () {
				var locationId = $(this).val();

				if (locationId) {
					$.ajax({
						url: '@Url.Action("GetAreasByLocation", "WarehouseRack")',  // Controller action to fetch areas
						type: 'GET',
						data: { locationId: locationId },
						success: function (data) {
							var areaDropdown = $('#WarehouseAreaId');
							areaDropdown.empty();  // Clear existing options
							areaDropdown.append('<option value="">Select warehouse area</option>'); // Default option

							// Populate the area dropdown with new options
							$.each(data, function (index, item) {
								areaDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
							});
						},
						error: function () {
							alert('Error fetching areas. Please try again.');
						}
					});
				} else {
					$('#WarehouseAreaId').empty();
					$('#WarehouseAreaId').append('<option value="">Select warehouse area</option>');
				}
			});
		});
	</script>
</head>
<body>
	<div class="container mt-4">
		<div class="ard">
			<div class="heade">
				<h4>Warehouse Rack Details</h4>
				<a href="/WarehouseRack/warehouseRackDataTab" class="btn btn-light">RETURN TO VIEW</a>
			</div>
			<div class="card-body">
				<form action="AddWarehouseRack" method="post" id="addWarehouseRackAlert">
					<div class="form-group">
						<label for="ddlWarehouseLocation">Warehouse Location:</label>
						<select class="form-control" name="WarehouseLocId" id="WarehouseLocId" required>
							<option value="">--Select warehouse location--</option>
							@foreach (var location in ViewBag.WarehouseLocationMasters)
							{
								<option value="@location.Value">@location.Text</option>
							}
						</select>
					</div>
					<div class="form-group">
						@* <span class="required">*</span> *@<label for="WarehouseAreaId">Warehouse Area Name:</label>
						<select id="WarehouseAreaId" name="WarehouseAreaId" class="form-control" required>
							<option value="">--Select warehouse area--</option>
						</select>
					</div>
					<div class="form-group">
						@* <span class="required">*</span> *@<label for="warehouseRackName">Warehouse Rack Name:</label>
						<input type="text" id="WarehouseRackName" class="form-control" name="WarehouseRackName" required><br />
					</div>
					<div class="text-center mt-3">
						<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
						<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</body>
</html>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
	const form = document.getElementById("addWarehouseRackAlert");
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		Swal.fire({
				title: "Are you sure?",
				text: "Create this WarehouseRack!",
				imageUrl: '/assets/img/alert.png',
				imageHeight: "100px",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, Create it!"
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: "Created!",
						text: "WarehouseRack has been created successfully.",
						icon: "success",
						timer: 2000,
						showConfirmButton: false
					}).then(() => {
						form.submit();
					});
				}
			});
		});
</script>