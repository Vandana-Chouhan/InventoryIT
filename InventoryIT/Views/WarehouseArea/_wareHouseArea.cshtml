<head>
    <link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
    <div class="ard">
        <div class="heade">
            <h4 style="font-size: 20px;">WAREHOUSE AREA</h4>
            <a href="/WarehouseArea/Index" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="card-body">
            <form action="/WarehouseArea/Save" method="post">
                <div class="row mb-2 align-items-center" style="margin-top: 79px;">
                    <label class="text-end" for="ddlWarehouseLocation">Warehouse Location Name:</label>
                    <div>
                        <select class="form-control" name="WarehouseLocationName" id="ddlWarehouseLocation" required>
                            <option value="" disabled selected>Select Location</option>
                            <option value="Indore">Location1</option>
                            <option value="Pune">Location2</option>
                            <option value="Dhar">Location3</option>
                            <option value="Mumbai">Location4</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="text-end" for="txtWarehouseArea">Warehouse Area Name:</label>
                    <div>
                        <input type="text" class="form-control" name="WarehouseAreaName" placeholder="Enter Warehouse Area Name" id="txtWarehouseArea" required>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
                    <button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>
