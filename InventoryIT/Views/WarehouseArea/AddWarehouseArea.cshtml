<head>
    <link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
    <div class="ard">
        <div class="heade">
            <h4>Warehouse Area</h4>
            <a href="/WarehouseArea/Index" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="card-body">
            <form action="/WarehouseArea/Save" method="post">
                <div class="row mb-2 align-items-center">
                    <label class="col-form-label" for="ddlWarehouseLocation">Warehouse Location Name:</label>
                    <div>
                        <select class="form-control" name="WarehouseLocationName" id="ddlWarehouseLocation" required>
                            <option value="" disabled selected>Select Location</option>
                            <option value="Indore">Location1</option>
                            <option value="Pune">Location2</option>
                            <option value="Dhar">Location3</option>
                            <option value="Mumbai">Location4</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-form-label" for="txtWarehouseArea">Warehouse Area Name:</label>
                    <div>
                        <input type="text" class="form-control" name="WarehouseAreaName" id="txtWarehouseArea" required>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="reset" class="btn btn-primary">Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>
