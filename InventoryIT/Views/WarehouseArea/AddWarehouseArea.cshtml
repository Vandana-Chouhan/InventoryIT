<head>
    <link rel="stylesheet" href="~/Warehouse/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
    <div class="ard">
        <div class="heade">
            <h4>Warehouse Area</h4>
            <a href="/WarehouseArea/warehouseAreaDataTab" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="card-body">
            <form action="AddWarehouseArea" method="post">
                @if (TempData["SuccessMessage"] != null && !Context.Request.Query.ContainsKey("reset"))
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <div class="row mb-2 align-items-center">
                    <label class="col-form-label" for="ddlWarehouseLocation">Warehouse Location Name:</label>
                    <div>
                        <select name="WarehouseLocId" class="form-control" required>
                            <option value="">--Select warehouse location--</option>
                            @foreach (var location in ViewBag.WarehouseLocationMasters)
                            {
                                <option value="@location.Value">@location.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-form-label" for="txtWarehouseArea">Warehouse Area Name:</label>
                    <div>
                        <input type="text" class="form-control" name="WarehouseAreaName" id="txtWarehouseArea" required>
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="reset" class="btn btn-primary" onclick="window.location.href = window.location.href + '?reset=true';">Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>
