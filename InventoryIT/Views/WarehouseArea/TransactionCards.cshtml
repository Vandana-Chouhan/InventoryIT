<script>
    $(document).ready(function () {
        $("#loadStockDetails").click(function (e) {
            e.preventDefault();
            $.get("@Url.Action("LoadStockDetails", "PurchageMgmt")", function (data) {
                $("#partialContent").html(data);
            });
        });
    });

</script>
