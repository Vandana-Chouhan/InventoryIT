<head>
	<style>
		body {
			background-color: whitesmoke;
		}

		.container {
			background-color: whitesmoke;
			padding: 20px;
			border-radius: 10px;
		}

		.card {
			background-color: whitesmoke;
			border-radius: 3px;
			padding: 0px;
			margin: 0 auto;
		}

		.header {
			background-color: #4268a1;
			color: white;
			padding: 8px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-radius: 2px;
		}

		.form-container {
			padding: 15px;
		}

		.form-group {
			display: flex;
			align-items: center;
			margin-bottom: 15px;
			gap: 15px;
		}

			.form-group label {
				font-weight: 600;
				min-width: 200px;
				text-align: right;
			}

			.form-group input {
				flex-grow: 1;
				padding: 5px;
				border: 1px solid #ccc;
				border-radius: 4px;
			}

		.btn-dark {
			background-color: black;
			color: white;
			padding: 5px 10px;
			text-decoration: none;
			border-radius: 3px;
		}

		.buttons {
			text-align: center;
			margin-top: 20px;
		}

		.btn-success, .btn-primary {
			padding: 5px 15px;
		}

	</style>
</head>
<div class="container mt-4">
	<div class="card">
		<div class="header">
			<h4>ITEM TYPE DETAILS</h4>
			<a asp-action="Index" class="btn btn-dark">RETURN TO VIEW</a>
		</div>
		<div class="form-container">
			<form asp-action="AddItemType" method="post" asp-controller="ItemType">
				<div class="form-group">
					<label for="ItemName">Item Type Name:</label>
					<input class="form-control" name="ItemName" required>
				</div>
				<div class="buttons">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="reset" class="btn btn-primary">Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>