<style>
	body {
		background-color: whitesmoke;
	}

	.bg-warning {
		background-color: #4268a1 !important;
	}

	.container {
		border-radius: 10px !important;
	}

	.mt-4 {
		margin-top: 5.5rem !important;
	} 
	.card-header{
	padding: 4px;
	}
</style>
@{
	ViewData["Title"] = "Spare Item";
}

<div class="container mt-4">
	<div class="card">
		<div class="card-header bg-warning text-white d-flex justify-content-between">
			<h5>PRODUCT DETAILS</h5>
			<a href="/SpareItem/Index" class="btn btn-dark">View All Products</a>
		</div>
		<div class="card-body bg-light">
			<form action="/SpareItem/SaveSpareItem" method="post">
				<div class="row mb-3 text-end">
					<label class="col-sm-2 col-form-label">* Item Company :</label>
					<div class="col-sm-10">
						<select class="form-control" id="ddlcompanyname" name="companyname" style="margin-top: 4px;">
							<option value="">--select item company--</option>
							<option value="company1">FSP Technologies</option>
							<option value="company2">Lenskart</option>
							<option value="company3">Myntra</option>
						</select>
					</div>
				</div>
				<div class="row mb-3 text-end">
					<label class="col-sm-2 col-form-label">* Item Name :</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="txtitemName" placeholder="Enter Item Name" name="SpareName">
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label text-end">Item Type:</label>
					<div class="col-sm-4">
						<select class="form-control" id="ddlItemtype" name="ItemType">
							<option value="">--Select Item Type--</option>
							<option value="type1">Type1</option>
							<option value="type2">Type2</option>
							<option value="type3">Type3</option>
						</select>
					</div>
					<label class="col-sm-2 col-form-label text-end">Item Unit :</label>
					<div class="col-sm-4">
						<select class="form-control" id="ddlItemunit" name="Itemunit">
							<option value="">--Select Item Unit--</option>
							<option value="unit1">Unit1</option>
							<option value="unit2">Unit2</option>
							<option value="unit3">Unit3</option>
						</select>
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label text-end">Item Category:</label>
					<div class="col-sm-4">
						<select class="form-control" id="ddlItemCategory" name="ItemCategory">
							<option value="">--Select Category Item--</option>
							<option value="Category1">Raw Material</option>
							<option value="Category2">Finished Goods</option>
							<option value="Category3">Reusable Goods</option>
						</select>
					</div>
					<label class="col-sm-2 col-form-label text-end">Item SubCategory :</label>
					<div class="col-sm-4">
						<select class="form-control" id="ddlItemSubCategory" name="ItemSubCategory">
							<option value="">--Select SubCategory Item--</option>
							<option value="SubCategory1">R1</option>
							<option value="SubCategory2">R2</option>
							<option value="SubCategory3">R3</option>
						</select>
					</div>
				</div>
				<div class="row mb-3 text-end">
					<label class="col-sm-4 col-form-label"style="margin-left:-101px;">*Ware House Location :</label>
					<div class="col-sm-6">
						<select class="form-control" id="ddlwarehouselocation" name="Warehouselocation" style="margin-left: -12px;">
							<option value="">--Select warehouse location--</option>
							<option value="location1">Rau</option>
							<option value="location2">Indore</option>
							<option value="location3">Bhopal</option>
						</select>
					</div>
				</div>
				<div class="row mb-3 text-end">
					<label class="col-sm-4 col-form-label" style="margin-left:-101px;">*Ware House Area:</label>
					<div class="col-sm-6">
						<select class="form-control" id="ddlwarehousearea" name="Warehousearea" style="margin-left: -12px;">
							<option value="">--Select warehouse area--</option>
							<option value="area1">Area1</option>
							<option value="area2">Area2</option>
							<option value="area3">Area3</option>
						</select>
					</div>
				</div>
				<div class="row mb-3 text-end">
					<label class="col-sm-4 col-form-label" style="margin-left:-101px;">*Ware House Rack :</label>
					<div class="col-sm-6">
						<select class="form-control" id="ddlwarehouserack" name="Warehouserack" style="margin-left: -12px;">
							<option value="">--Select warehouse rack--</option>
							<option value="rack1">Rack1</option>
							<option value="rack2">Rack2</option>
							<option value="rack3">Rack3</option>
						</select>
					</div>
				</div>
				<div class="row mb-3 text-end">
					<label class="col-sm-4 col-form-label" style="margin-left:-101px;">*Ware House Shelf :</label>
					<div class="col-sm-6">
						<select class="form-control" id="ddlwarehouseshelf" name="Warehouseshelf" style="margin-left: -12px;">
							<option value="">--Select warehouse shelf--</option>
							<option value="shelf1">Shelf1</option>
							<option value="shelf2">Shelf2</option>
							<option value="shelf3">Shelf3</option>
						</select>
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label text-end">Opening Stock :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtopeningstk" name="OpeningStock">
					</div>
					<label class="col-sm-2 col-form-label text-end">Current Stock :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtcurrentstk" name="CurrentStock">
					</div>
					<label class="col-sm-2 col-form-label text-end">Buffer Stock :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtbufferstk" name="BufferStock">
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label text-end">Rate :</label>
					<diva class="col-sm-2">
						<input type="text" class="form-control" id="txtRate" name="Rate">
					</diva>
					<label class="col-sm-2 col-form-label text-end">GST % :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtvat" name="Vat">
					</div>
					<label class="col-sm-2 col-form-label text-end">Value Of Stock :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtvalueofstk" name="ValueOfStock">
					</div>
				</div>
				<div class="row mb-3">
					<label class="col-sm-2 col-form-label text-end">Part No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" id="txtpartno" name="PartNo">
					</div>
					<label class="col-sm-2 col-form-label text-end">Sales Price :</label>
					<div class="col-sm-6">
						<input type="text" class="form-control" id="txtsalesprice" name="SalesPrice">
					</div>
				</div>
				<div class="card mt-3">
					<div class="card-header bg-warning text-white">
						<h5>SUPPLIER INFORMATION FOR ABOVE PRODUCT</h5>
					</div>
					<div class="card-body">
						<div class="row mb-3 text-end align-items-center">
							<label class="col-sm-2 col-form-label">* Supplier Name :</label>
							<div class="col-sm-2">
								<select class="form-control" id="ddlsuppliername" name="SupplierName">
									<option>--Select Supplier Name--</option>
								</select>
							</div>
							<label class="col-sm-2 col-form-label" style="margin-left:-48px">* Company Name :</label>
							<div class="col-sm-2">
								<select class="form-control" id="ddlcompanyname" name="companyname">
									<option value="">--select company name--</option>
									<option value="company1">FSP Technologies</option>
									<option value="company2">Lenskart</option>
									<option value="company3">Myntra</option>
								</select>
							</div>
							<label class="col-sm-2 col-form-label" style="margin-left:-109px">Rate :</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" placeholder="Enter Supplier Rate" id="txtrate" name="SupplierRate">
							</div>
							<div class="col-sm-1 text-start">
								<button type="button" class="btn btn-warning" style="margin-left: 84px;">OK</button>
							</div>
						</div>
						<div class="table-responsive">
							<table class="table table-bordered">
								<thead>
									<tr>
										<th>Supplier Name</th>
										<th>Company Name</th>
										<th>Rate</th>
										<th>Action</th>

									</tr>
								</thead>
								<tbody>
									<tr>
										<td colspan="3" class="text-center">No data available</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="reset" class="btn btn-primary">Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>