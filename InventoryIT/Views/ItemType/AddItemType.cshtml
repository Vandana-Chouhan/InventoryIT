<head>
    <link rel="stylesheet" href="~/ItemSetup/style.css" asp-append-version="true" />
</head>

<div class="container mt-4">
    <div class="card">
        <div class="heade">
            <h4>ITEM TYPE DETAILS</h4>
            <a href="/ItemType/ItemtypeDataTable" id="returnToMaster" class="btn btn-dark">RETURN TO VIEW</a>
        </div>
        <div class="form-container">
            <form asp-action="AddItemType" method="post" asp-controller="ItemType">
                @if (TempData["SuccessMessage"] != null && !Context.Request.Query.ContainsKey("reset"))
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                <div class="form-group">
                    <label class="text-end" for="ItemName">Item Type Name:</label>
                    <input class="form-control"name="ItemName" required>
                </div>

                <!-- Hidden Fields -->
                <input type="hidden" value="@ViewBag.SelectedCompId" />
                <input type="hidden" value="@ViewBag.SelectedBranchId" />
                <input type="hidden" value="@ViewBag.SelectedFinanYearId" />

                <div class="buttons">
                    <button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
                    <button type="reset" onclick="window.location.href = window.location.href + '?reset=true';" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>


<div id="partialContent"></div>

<script>
    $(document).ready(function () {
        $("#returnToMaster").click(function (e) {
            e.preventDefault();

            $.get("@Url.Action("LoadMasterData", "ItemSetup")", function (data) {
                $("#partialContent").html(data);
            });
        });
    });
</script>