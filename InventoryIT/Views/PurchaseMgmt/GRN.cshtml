<style>
    .grn-container {
        background-color: #ffffff;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ddd;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    }

   
    .main-header {
        background-color: #4268a1;
        color: white;
        font-size: 20px;
        font-weight: bold;
        padding: 12px;
        text-align: center;
        border-radius: 5px;
        width: 100%;
       
    }

    .main-header {
        width: calc(100% - -39px);
        margin: 0 auto;
        margin-left: -19px;
        margin-top: -20px;
    }
    .card {
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
        margin-top: 15px;
    }

    .card-header {
        background-color: #2c3e50;
        color: white;
        font-size: 18px;
        font-weight: bold;
        padding: 10px;
    }

    .footer-buttons {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
    }

    .text-end {
        text-align: right;
    }

    .form-control, .form-select {
        border-radius: 5px;
        border: 1px solid #ced4da;
        padding: 8px;
    }

    button {
        padding: 10px 20px;
        font-size: 16px;
        font-weight: bold;
    }
</style>

<div class="container mt-4">
    <div class="grn-container">
        <div class="main-header">PRODUCT GRN DETAILS</div>

        <!-- GRN INVOICE DETAILS -->
        <div class="card">
            <div class="card-header">GRN INVOICE DETAILS</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-2 text-end">
                        <label class="form-label">Serial No:</label>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" value="275" readonly>
                    </div>
                    <div class="col-md-2 text-end">
                        <label class="form-label">GRN No:</label>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control" value="SGRN/1819/275" readonly>
                    </div>
                    <div class="col-md-2 text-end">
                        <label class="form-label">Invoice No:</label>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-2 text-end">
                        <label class="form-label">Without PO No:</label>
                    </div>
                    <div class="col-md-2">
                        <input type="checkbox" class="form-check-input">
                    </div>
                    <div class="col-md-2 text-end">
                        <label class="form-label">PO No:</label>
                    </div>
                    <div class="col-md-2">
                        <select class="form-select">
                            <option>PO Number</option>
                        </select>
                    </div>
                    <div class="col-md-2 text-end">
                        <label class="form-label">Purchase From:</label>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <!-- GRN ITEM DETAILS -->
        <div class="card">
            <div class="card-header">GRN ITEM DETAILS</div>
            <div class="card-body">
                <textarea class="form-control" rows="5"></textarea>
            </div>
        </div>

        <!-- GRN AMOUNT DETAILS -->
        <div class="card">
            <div class="card-header">GRN AMOUNT DETAILS</div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Remark:</label>
                    </div>
                    <div class="col-md-9">
                        <input type="text" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Payment Mode:</label>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select">
                            <option>Payment Mode</option>
                        </select>
                    </div>
                    <div class="col-md-3 text-end">
                        <label class="form-label">Cheque Date:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="date" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Cheque No:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                    <div class="col-md-3 text-end">
                        <label class="form-label">Gross Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Disc. Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                    <div class="col-md-3 text-end">
                        <label class="form-label">IGST Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">CGST Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                    <div class="col-md-3 text-end">
                        <label class="form-label">SGST Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-3 text-end">
                        <label class="form-label">Net Amount:</label>
                    </div>
                    <div class="col-md-3">
                        <input type="text" class="form-control">
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-buttons">
            <button class="btn btn-success">Save</button>
            <button class="btn btn-primary">Refresh</button>
        </div>
    </div>
</div>