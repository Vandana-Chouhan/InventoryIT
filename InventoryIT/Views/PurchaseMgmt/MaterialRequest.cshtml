<style>
	body {
		background-color: whitesmoke;
	}

	.bg-warning {
		background-color: #4268a1 !important;
	}

	.mt-4 {
		margin-top: 1.5rem !important;
	}

	.modal-header {
		background-color: #99c3c3;
	}
</style>
@{
	ViewData["Title"] = "Product Material Request Details";
}

<div class="container mt-4">
	<div class="card">
		<div class="card-header bg-warning text-white d-flex justify-content-between">
			<h4>PRODUCT MATERIAL REQUEST DETAILS</h4>
			<a href="/SpareMaterialRequest/Index" class="btn btn-dark">VIEW ALL PRODUCT MATERIAL REQUESTS</a>
		</div>
		<div class="card-body bg-light">
			<form action="/SpareMaterialRequest/Save" method="post">
				<div class="row mb-3 align-items-center">
					<label class="col-sm-1 col-form-label text-end" style="margin-left:104px;">Serial No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" name="SerialNo" readonly>
					</div>
					<label class="col-sm-1 col-form-label text-end">* MTR No :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" name="MTRNo" required>
					</div>
					<label class="col-sm-1 col-form-label text-end">MTR Date :</label>
					<div class="col-sm-2">
						<input type="date" class="form-control" name="MTRDate">
					</div>
					<div class="col-sm-2" style="margin-right: -25px;">
						<button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#addItemModal">Add Items</button>
					</div>
				</div>
				<div class="row mb-3">
					<div class="col-sm-10 offset-sm-2">
						<textarea class="form-control" rows="6" name="ItemDetails"></textarea>
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Total Order Quantity :</label>
					<div class="col-sm-2">
						<input type="text" class="form-control" name="TotalOrderQuantity" readonly>
					</div>
				</div>
				<div class="row mb-3 align-items-center">
					<label class="col-sm-2 col-form-label text-end">Remark :</label>
					<div class="col-sm-10">
						<textarea class="form-control" name="Remark" rows="3"></textarea>
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success">Save</button>
					<button type="reset" class="btn btn-primary">Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
<!-- Add Items Modal -->
<div class="modal fade" id="addItemModal" tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="addItemModalLabel">SELECT ITEM TO ADD</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body" style="max-height: 400px; overflow-y: auto;">

				<div class="mb-3 d-flex align-items-center">
					<label for="spareCategory" class="form-label me-2">Product Category:</label>
					<select class="form-select flex-grow-1" style="width:75%" id="spareCategory">
						<option selected>Product Type</option>
					</select>
				</div>
				<div style="max-height: 300px; overflow-y: auto;">
					<table class="table table-bordered">
						<thead>
							<tr>
								<th>Select</th>
								<th>Product Name-Company</th>
								<th>Product Type</th>
								<th>Unit</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td><input type="checkbox"></td>
								<td>Sample Item 1</td>
								<td>Engine</td>
								<td>NOS</td>
							</tr>
							<tr>
								<td><input type="checkbox"></td>
								<td>Sample Item 2</td>
								<td>Pump</td>
								<td>NOS</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
			<div class="modal-footer d-flex justify-content-center">
				<button type="button" class="btn btn-danger">OK</button>
				<button type="button" class="btn btn-dark" data-bs-dismiss="modal">CLOSE</button>
			</div>
		</div>
	</div>
</div>