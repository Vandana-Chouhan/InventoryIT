<style>
    .image-back {
        background-image: url('/wwwroot/images/image2.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        width: 100%;
        height: 100vh;
        margin-left: -10px;
        margin-top: 19px;
    }
    .container-items {
        margin-top: 18px;
    }
    .item-container {
        height: 143px;
        width: 152px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa; /* Light background */
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.2);
    }
    .item-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
    }
    .item-icon {
        width: 68px;
        height: 68px;
        background-color: #007bff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: bold;
    }
    .item-title {
        margin-top: 12px;
        font-size: 16px;
        font-weight: bold;
        color: #333;
    }
    .col-md-2 {
        flex: 0 0 auto;
        width: 18%;
        margin-top: 60px;
    }
</style>

<div class="image-back">
    <div class="container-items">
        <div class="row" style="margin-left: 61px;">
            <div class="col-md-2 mb-2">
                <div class="item-container" id="loadMaterialRequest">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">Material Request</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="item-container" id="loadProductOrder">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">Purchase Order</p>
                    </div>
                </div>
            </div>

            <div class="col-md-2 mb-2">
                <div class="item-container" id="loadGRN">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">GRN</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="item-container" id="loadProduct">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">Item Issue</p>
                    </div>
                </div>
            </div>

            <div class="col-md-2 mb-2">
                <div class="item-container" id="loadProductReturn">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">Item Return</p>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-2">
                <div class="item-container" id="itemstockupdate">
                    <div class="item-content">
                        <div class="item-icon"></div>
                        <p class="item-title">Item Stock Update</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#loadMaterialRequest").click(function (e) {
            e.preventDefault();
            $.get("@Url.Action("MaterialRequest", "PurchaseMgmt")", function (data) {
                $("#partialContent").html(data);
            });
        });
    });
</script>

