<style>

	.container {
		background-color: whitesmoke;
		padding: 20px;
		border-radius: 10px;
		box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.2);
	}

	.hed {
		background-color: #4268a1;
		color: white;
		font-size: 20px;
		font-weight: bold;
		padding: 10px;
		text-align: left;
	}

	.hed {
		width: calc(100% - -38px);
		margin: 0 auto;
		margin-left: -19px;
		border-radius: 5px;
		margin-top: -19px
	}

	.section-header {
		background-color: #2c3e50;
		color: white;
		font-size: 18px;
		font-weight: bold;
		padding: 10px;
	}

	.form-control, .form-select {
		border-radius: 5px;
	}

	.btn-ok {
		background-color: #f39c12;
		color: white;
		font-weight: bold;
	}

	.btn-save {
		background-color: #28a745;
		color: white;
		font-weight: bold;
	}

	.btn-refresh {
		background-color: #343a40;
		color: white;
		font-weight: bold;
	}
</style>

<div class="container mt-4">
	<div class="hed">PRODUCT RETURN DETAILS</div>

	<div class="card mt-3">
		<div class="section-header">RETURN DETAILS</div>
		<div class="card-body">
			<div class="row mb-3">
				<label class="col-md-2 text-end">Issue Slip No:</label>
				<div class="col-md-2"><input type="text" class="form-control" value="109" readonly></div>
				<label class="col-md-2 text-end">Vehicle No:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
			</div>
			<div class="row mb-3">
				<label class="col-md-2 text-end">Item Issue Date:</label>
				<div class="col-md-2"><input type="date" class="form-control"></div>
			</div>
		</div>
	</div>

	<div class="card mt-3">
		<div class="section-header">PRODUCT TO RETURN DETAILS</div>
		<div class="card-body">
			<div class="row mb-3">
				<label class="col-md-2 text-end">Product Name:</label>
				<div class="col-md-4"><input type="text" class="form-control"></div>
				<label class="col-md-2 text-end">Product Type:</label>
				<div class="col-md-4"><input type="text" class="form-control"></div>
			</div>
			<div class="row mb-3">
				<label class="col-md-2 text-end">Rate:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
				<label class="col-md-2 text-end">Rate Wise Stock:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
				<label class="col-md-2 text-end">Total Stock:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
			</div>
			<div class="row mb-3">
				<label class="col-md-2 text-end">Quantity To Return:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
				<label class="col-md-2 text-end">Unit:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
				<label class="col-md-2 text-end">Amount:</label>
				<div class="col-md-2"><input type="text" class="form-control"></div>
			</div>
			<div class="row mb-3">
				<label class="col-md-2 text-end">Remark:</label>
				<div class="col-md-6"><input type="text" class="form-control"></div>
				<div class="col-md-2">
					<button class="btn btn-ok w-100">OK</button>
				</div>
			</div>
		</div>
	</div>

	<div class="card mt-3">
		<div class="section-header">PRODUCT ISSUED</div>
		<div class="card-body">
			<textarea class="form-control" rows="5"></textarea>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-6 text-end">
			<label>Total Quantity Issued:</label>
			<input type="text" class="form-control d-inline w-25" value="0.00" readonly>
		</div>
		<div class="col-md-6 text-start">
			<label>Total Amount:</label>
			<input type="text" class="form-control d-inline w-25" value="0.00" readonly>
		</div>
	</div>
	<div class="row mt-3">
		<div class="col-md-2 text-end">
			<label class="form-label">Remarks:</label>
		</div>
		<div class="col-md-10">
			<textarea class="form-control" rows="2"></textarea>
		</div>
	</div>

	<div class="footer-buttons text-center mt-4">
		<button class="btn btn-save">Save</button>
		<button class="btn btn-refresh">Refresh</button>
	</div>
</div>


