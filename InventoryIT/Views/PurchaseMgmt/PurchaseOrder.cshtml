
<style>
   
    .purchase-order-container {
        background-color: #ffffff; 
        padding: 15px;
        border-radius: 10px;
        border: 2px solid whitesmoke; 
        box-shadow: 5px 5px 15px rgba(0, 0, 255, 0.5); 
    }

    /* Main Header Styling */
    .main-header {
        background-color: #4268a1;
        color: white;
        font-size: 18px;
        font-weight: bold;
        padding: 10px;
        text-align: center;
        border-radius: 5px;
    }

    .main-header {
        width: calc(100% - -34px);
