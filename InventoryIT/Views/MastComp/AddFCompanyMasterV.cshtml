<head>
	<link rel="stylesheet" href="~/Company/style.css" asp-append-version="true" />
</head>
@{
	ViewData["Title"] = "Company Details";
}

<div class="container mt-4">
	<div class="car">
		<div class="card-heade text-white d-flex justify-content-between" style="border-radius:5px;height:42px;">
			<h4 style="font-size: 20px;
                font-weight: bold;">
				COMPANY DETAILS
			</h4>
			<a href="/MastComp/ShowMastCompDataTable" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
				RETURN TO VIEW
			</a>     
		</div>
		<div class="card-body">
			<form asp-action="AddFCompanyMaster"asp-controller="MastComp" method="post" style="background-color: white;">
		 <div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Company Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtCompany name" name="CompanyName">
					</div>
					<label class="col-sm-2 col-form-label text-end">ShortCompany Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtShortCompanyName" name="CompShortName">
					</div>
				</div>

				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Address:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="txtaddress" name="Address" required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Branch Short Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtbranchshortname" name="BranchShortName" required>
					</div>
					<label class="col-sm-2 col-form-label text-end">Owner Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtownername" name="OwnerName" required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">City:</label>
					<div class="col-sm-4">
						<select class="form-control" name="City" id="ddlcity" required>
							<option value="" disabled selected>Select City</option>
							<option value="Indore">Indore</option>
							<option value="Pune">Pune</option>
							<option value="Dhar">Dhar</option>
							<option value="Mumbai">Mumbai</option>
						</select>
					</div>
					<label class="col-sm-2 col-form-label text-end">State:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtstate" name="State">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Email:</label>
					<div class="col-sm-4">
						<input type="email" class="form-control" id="txtemail" name="Email">
					</div>
					<label class="col-sm-2 col-form-label text-end">PIN No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtpinno" name="PinNo">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Mobile No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtmobileno" name="MobileNo">
					</div>
					<label class="col-sm-2 col-form-label text-end">Phone No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtphoneno" name="PhoneNo">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">GST No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtgstno" name="GstNo">
					</div>
					<label class="col-sm-2 col-form-label text-end">PAN No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtpanno" name="PanNo">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Contact Person:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtcontactno" name="ContactPerson">
					</div>
					<label class="col-sm-2 col-form-label text-end">Website:</label>
					<div class="col-sm-4">
						<input type="url" class="form-control" id="txtwebsite" name="Website">
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
					<button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
