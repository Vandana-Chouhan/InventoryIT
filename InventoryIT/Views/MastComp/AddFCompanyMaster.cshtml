@model InventoryIT.Models.MastComp
<head>
	<link rel="stylesheet" href="~/Company/style.css" asp-append-version="true" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script type="text/javascript">
		$(document).ready(function () {
			// When the State dropdown changes, update the City dropdown.
			$('#State').change(function () {
				var stateId = $(this).val();
				console.log("Selected State ID: " + stateId); // Check the state ID
				if (stateId) {
					$.ajax({
						url: '@Url.Action("GetCityByState", "MastComp")', // Ensure this URL is correct
						type: 'GET',
						data: { stateid: stateId },
						success: function (data) {
							console.log("City data received:", data); // Log the data received

							var cityDropdown = $('#CityId');
							cityDropdown.empty(); // Clear existing options
							cityDropdown.append('<option value="">Select City</option>'); // Default option

							// Populate the city dropdown with new options
							$.each(data, function (index, item) {
								cityDropdown.append('<option value="' + item.value + '">' + item.text + '</option>');
							});
						},
						error: function (xhr, status, error) {
							console.log('Error:', error); // Log the error if any
							alert('Error fetching Cities. Please try again.');
						}
					});
				} else {
					// If no state is selected, reset the city dropdown
					$('#CityId').empty();
					$('#CityId').append('<option value="">Select City</option>');
				}
			});
		});
	</script>
</head>
@{
	ViewData["Title"] = "Company Details";
}
<div class="container mt-4">
	<div class="car">
		<div class="card-heade text-white d-flex justify-content-between" style="border-radius:5px;height:42px;">
			<h4 style="font-size: 20px;
                font-weight: bold;">
				COMPANY DETAILS
			</h4>
			<a href="/MastComp/ShowMastCompDataTable" class="btn btn-light" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
				RETURN TO VIEW
			</a>
		</div>
		<div class="card-body">
			<form asp-action="AddFCompanyMaster" asp-controller="MastComp" method="post" style="background-color: white;" id="addMastCompanyforms">
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Company Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtCompany name" name="CompanyName"required>
					</div>
					<label class="col-sm-2 col-form-label text-end">ShortCompany Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtShortCompanyName" name="CompShortName"required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Address:</label>
					<div class="col-sm-10">
						<input type="text" class="form-control" id="txtaddress" name="Address" required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Owner Name:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtownername" name="OwnerName" required>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">State:</label>
					<div class="col-sm-4">
						<select name="State" id="State" class="form-control">
							<option value="" disabled selected>Select state</option>
							@foreach (var state in ViewBag.MastStates)
							{
								<option value="@state.Value">@state.Text</option>
							}
						</select>
					</div>
					<label class="col-sm-2 col-form-label text-end">City:</label>
					<div class="col-sm-4">
						<select name="City" id="CityId" class="form-control" required>
							<option value="">Select City</option>
						</select>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Email:</label>
					<div class="col-sm-4">
						<input type="email" class="form-control" id="txtemail" name="Email">
					</div>
					<label class="col-sm-2 col-form-label text-end">PIN No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtpinno" name="PinNo">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Mobile No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtmobileno" name="MobileNo" required>
						<span asp-validation-for="MobileNo" class="text-danger"></span>
					</div>
					<label class="col-sm-2 col-form-label text-end">Phone No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtphoneno" name="PhoneNo" required>
						<span asp-validation-for="PhoneNo" class="text-danger"></span>
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">GST No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtgstno" name="GstNo">
					</div>
					<label class="col-sm-2 col-form-label text-end">PAN No:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtpanno" name="PanNo">
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-2 col-form-label text-end">Contact Person:</label>
					<div class="col-sm-4">
						<input type="text" class="form-control" id="txtcontactno" name="ContactPerson">
					</div>
					<label class="col-sm-2 col-form-label text-end">Website:</label>
					<div class="col-sm-4">
						<input type="url" class="form-control" id="txtwebsite" name="Website">
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
					<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
	const form = document.getElementById("addMastCompanyforms");
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		Swal.fire({
				title: "Are you sure?",
				text: "Create this CompanyDetails!",
				imageUrl: '/assets/img/alert.png',
				imageHeight: "100px",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, Create it!"
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: "Created!",
						text: "CompanyDetails has been created successfully.",
						icon: "success",
						timer: 2000,
						showConfirmButton: false
					}).then(() => {
						form.submit();
					});
				}
			});
		});
</script>