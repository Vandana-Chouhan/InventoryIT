
<head>
    <link rel="stylesheet" href="~/Company/style.css" asp-append-version="true" />
</head>
@{
    ViewData["Title"] = "Company Details";
}

<div class="container mt-4">
    <div class="car">
        <div class="card-heade text-white d-flex justify-content-between" style="border-radius:5px;">
            <h4>COMPANY DETAILS</h4>
            <a href="/CompanyMaster/Index" style="background-color:#f8f9fa;color:black;">RETURN TO VIEW</a>
        </div>
        <div class="card-body bg-light">
            <form action="/CompanyMaster/Save" method="post">

                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Company Name :</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" placeholder="Enter Company Name" id="txtcompanyName" name="CompanyName" required>
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Address :</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" placeholder="Enter Address" id="txtaddress" name="Address" required>
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Comp. Short Name :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter Short Name" id="txtcompanyShortName" name="CompShortName" required>
                    </div>
                    <label class="col-sm-2 col-form-label text-end">Owner Name :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter Owner Name" id="txtownerName" name="OwnerName" required>
                    </div>
                </div>
               @*  <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">City :</label>
                    <div class="col-sm-4 d-flex">
                        <select class="form-control" id="ddlcity" name="City" required>
                            <option value="" disabled selected>Select City</option>
                            <option value="Indore">Indore</option>
                            <option value="Pune">Pune</option>
                            <option value="Dhar">Dhar</option>
                            <option value="Mumbai">Mumbai</option>
                        </select>
                     
                    </div>
                    <label class="col-sm-2 col-form-label text-end">State :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter State" id="txtstate" name="State">
                    </div>
                </div> *@
                <div class="row mb-2">
                    <label class="col-sm-2 col-form-label text-end">City:</label>
                    <div class="col-sm-4">
                        <select class="form-control" name="City" id="ddlcity" required>
                            <option value="" disabled selected>Select City</option>
                            <option value="Indore">Indore</option>
                            <option value="Pune">Pune</option>
                            <option value="Dhar">Dhar</option>
                            <option value="Mumbai">Mumbai</option>
                        </select>
                    </div>
                    <label class="col-sm-2 col-form-label text-end">State:</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="txtstate" name="State">
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Email :</label>
                    <div class="col-sm-4">
                        <input type="email" class="form-control" placeholder="Enter Email" id="txtemail" name="Email">
                    </div>
                    <label class="col-sm-2 col-form-label text-end">PIN No :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter PIN No" id="txtpinNo" name="PinNo">
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Mobile No :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter Mobile No" id="txtmobileNo" name="MobileNo">
                    </div>
                    <label class="col-sm-2 col-form-label text-end">Phone No :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter Phone No" id="txtphoneNo" name="PhoneNo">
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">GST No :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter GST No" id="txtgstNo" name="GstNo">
                    </div>
                    <label class="col-sm-2 col-form-label text-end">PAN No :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter PAN No" id="txtpanNo" name="PanNo">
                    </div>
                </div>
                <div class="row mb-2 align-items-center">
                    <label class="col-sm-2 col-form-label text-end">Contact Person :</label>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" placeholder="Enter Contact Person" id="txtcontactPerson" name="ContactPerson">
                    </div>
                    <label class="col-sm-2 col-form-label text-end">Website :</label>
                    <div class="col-sm-4">
                        <input type="url" class="form-control" placeholder="Enter Website" id="txtwebsite" name="Website">
                    </div>
                </div>
                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-success">Save</button>
                    <button type="reset" class="btn btn-primary">Refresh</button>
                </div>
            </form>
        </div>
    </div>
</div>  