@model InventoryIT.Models.ItemCatagory
<!--ITEM Category Design-->
<head>
	<style>
		/* div:where(.swal2-container).swal2-center > .swal2-popup {
									grid-column: 2;
									grid-row: 2;
									place-self: center center;
									width: 35%;
								}
						 */
		body {
			background-color: white;
		}

		.container {
			background-color: white;
			padding: 20px;
			border-radius: 10px;
			width: 100%;
		}

		.card {
			background-color: white;
			border-radius: 3px;
			padding: 0px;
			margin: 0 auto;
			/* margin-left: -283px; */
			width: 1240px;
			height: 443px;
			box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.3);
		}

		.heade {
			background: linear-gradient(to right, #093f82, #2b71c7);
			color: white;
			padding: 8px;
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-radius: 5px;
			height: 42px;
			width: 1240px;
		}

		.form-container {
			padding: 15px;
		}

		.form-group {
			display: flex;
			align-items: center;
			margin-bottom: 15px;
			gap: 15px;
			width: 938px;
			margin-top: 10px;
		}

			.form-group label {
				font-weight: 600;
				min-width: 320px;
				text-align: right;
			}

			.form-group input {
				flex-grow: 1;
				padding: 5px;
				border: 1px solid #ccc;
				border-radius: 4px;
			}

		.btn-dark {
			text-decoration: none;
			border-radius: 3px;
			background-color: #f8f9fa;
			color: black;
			background-color: black;
			color: #f6f9ff;
			font-size: 14px;
			font-weight: bold;
			padding: 5px;
			text-decoration: none;
		}

		.buttons {
			text-align: center;
			margin-top: 245px;
		}

		.btn-success, .btn-primary {
			padding: 5px 15px;
		}

		h4 {
			font-size: 20px;
			font-weight: bold;
			margin-top: 7px;
		}

		.col-form-label {
			font-size: 14px;
			font-weight: bold;
			color: black;
		}

		.form-control {
			font-size: 14px;
			color: black;
		}

		.mt-4 {
			/* margin-left: 192px; */
			margin-top: -0.5rem !important;
		}

		@@media (min-width: 1700px) {
			.container {
				max-width: 1700px;
			}
		}

		@@media (min-width: 1700px) {
			.container {
				max-width: 1700px;
			}
		}

		@@media (min-width: 1700px) {
			.container {
				max-width: 1700px;
			}
		}

		@@media (min-width: 1700px) {
			.container {
				max-width: 1700px;
			}
		}

		h4 {
			font-size: 20px;
			font-weight: bold;
		}

		.text-end {
			font-size: 14px;
			font-weight: bold;
		}

		.btn-light {
			color: white;
			background-color: black;
			border-color: #f8f9fa;
			font-weight: bold;
		}

			.btn-light:hover {
				background-color: black;
				border-color: white;
				color: white;
			}

		.equal-width-btn {
			width: 95px;
			padding: 4px;
		}
	</style>
</head>
<div class="container mt-4">
	<div class="card">
		<h4>ITEM CATEGORY DETAILS</h4>
		<div class="heade">
			<a href="/ItemCatagory/itemcategoryDataTable" class="btn btn-light">RETURN TO VIEW</a>
		</div>
		<div class="card-body">
			<form action="AddItemCatagory" method="post">
				<div class="form-group">
					<label for="ItemCategoryName">
						<span class="text-danger">*</span> Item Catagory Name:
					</label>
					<div class="col-sm-9">
						<input type="text" class="form-control" asp-for="ItemCatagoryName">
						<span asp-validation-for="ItemCatagoryName" class="text-danger"></span>
					</div>
				</div>
				<div class="buttons">
					<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
					<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
				</div>
			</form>
		</div>
	</div>
</div>
