<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
	<style>
		#location{
			height:30px;
		}
	</style>
</head>
<body>
	<form asp-action="WarehouseArea" method="post">
		<div class="panel">
			<div class="header">
				<h4>Warehouse Area Details</h4>
				<input type="button" id="return-to-view" value="Return to View" />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="location">Warehouse Location Name:</label>
				<select id="location" class="input-small" name="WarehouseLocationName" required>
					<option value="" disabled selected>Select Location</option>
					<option value="Indore">Location1</option>
					<option value="Pune">Location2</option>
					<option value="Dhar">Location3</option>
					<option value="Mumbai">Location4</option>
				</select>
			</div>

			<div class="form-group">
				<span class="required">*</span><label for="warehouseAreaName">Warehouse Area Name:</label>
				<input type="text" id="warehouseAreaName" class="input-small" name="warehouseAreaName" required><br />
			</div>


			<div class="form-group form-group-flex">
				<input type="button" id="Save" value="Save" />
				<input type="button" id="Refresh" value="Refresh" />
			</div>
		</div>
	</form>
</body>
</html>












