            </div>
        </div>
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            @* <span>Orders with item short</span> *@
            <div class="box-item">
                <h6 style="margin-left: 14px;
                           margin-top: 17px;
                         font-size: 13px;
                         font-weight: bolder">
                    Orders with item short
                </h6>
                <div class="m" style="margin-left: 37px;
                         font-size: 17px;
                         color: blue;">
                    1
                </div>
            </div>
        </div>
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            @* <span>Order ready for dispath</span> *@
