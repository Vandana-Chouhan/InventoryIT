@{
    ViewData["Title"] = "Dashboard";
}


<style>
    .mt-4 {
        margin-top: 6.5rem !important;
    }

    .p-3 {
        padding: 3rem !important;
    }

    .mt-4 {
        width: 71%
    }

    .mb {
        align-items: center;
        margin-left: 27px;
        margin-top: 25px;
        font-size: 17px;
        color: blue;
    }

    .box-item {
        font-size: 12px;
        margin-top: -24px;
        font-weight: bolder;
        align-items: center;
    }

    .container {
        width: 677px;
    }
</style>
<!-- Purchase Management Section -->
<div class="container mb-5 p-3 border rounded shadow">
    <h5 class="bg-primary text-white p-2 rounded" style="margin-top: -48px; width: 675px;margin-left: -48px;">
        Purchase Management
    </h5>
    <div class="d-flex flex-wrap gap-3">
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            <div class="box-item">
                <span>Total MTR</span>
                <div class="mb">5</div>
            </div>
        </div>

        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            <div class="box-item">
                <span>Total PO</span>
                <div class="mb">5</div>
            </div>
        </div>
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            <div class="box-item">
                <span>Partial PO</span>
                <div class="mb">0</div>
            </div>
        </div>
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            <div class="box-item">
                <span>Total GRN</span>
                <div class="mb">5</div>
            </div>
        </div>
        <div class="box border rounded shadow d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">

            <div class="box-item">
                <h6 style="margin-left: 14px;
                           margin-top: 17px;
                         font-size: 13px;
                         font-weight: bolder">
                    Total item stockin
                </h6>
                <div class="m" style="margin-left: 37px;
                         font-size: 17px;
                         color: blue;">
                    5
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Store Section -->
