<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="FCompanyMaster" method="post">
		<div class="panel">
			<div class="header">
				<h4>Company Details</h4>
				<input type="button" id="return-to-view" value="Return to View" />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="companyName">Company Name:</label>
				<input type="text" id="companyName" class="input-large" name="CompanyName" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="address">Address:</label>
				<input type="text" id="address" class="input-large" name="Address" required><br />
			</div>
			<div class="row">
				<div class="form-group">
					<span class="required">*</span><label for="companyShortName">Comp.Short Name:</label>
					<input type="text" id="companyShortName" class="input-small" name="CompShortName" required><br />
				</div>
				<div class="form-group">
					<span class="required">*</span><label for="ownerName">Owner Name:</label>
					<input type="text" id="ownerName" class="input-small" name="OwnerName" required><br />
				</div>
			</div>
			<div class="row">
				<div class="form-group">
					<span class="required">*</span><label for="city">City:</label>
					<select id="city" class="input-small" name="City" required>
						<option value="" disabled selected>Select City</option>
						<option value="Indore">Indore</option>
						<option value="Pune">Pune</option>
						<option value="Dhar">Dhar</option>
						<option value="Mumbai">Mumbai</option>
					</select><br />
				</div>
				<div class="form-group">
					<label for="state">State:</label>
					<input type="text" id="state"name="State" class="input-small"><br />
				</div>
			</div>
			<div class="row">
				<div class="form-group">
					<label for="email">Email:</label>
					<input type="email" id="email" name="Email" class="input-small"><br />
				</div>
				<div class="form-group">
					<label for="pinNo">PIN No:</label>
					<input type="text" id="pinNo" name="PinNo" class="input-small"><br />
				</div>
			</div>
			<div class="row">
				<div class="form-group">
					<label for="mobileNo">Mobile No:</label>
					<input type="text" id="mobileNo" name="MobileNo" class="input-small"><br />
				</div>
				<div class="form-group">
					<label for="phoneNo">Phone No:</label>
					<input type="text" id="phoneNo" name="PhoneNo" class="input-small"><br />
				</div>
			</div>
			<div class="row">
				<div class="form-group">
					<label for="gstNo">GST No:</label>
					<input type="text" id="gstNo" name="GstNo" class="input-small"><br />
				</div>
				<div class="form-group">
					<label for="panNo">PAN No:</label>
					<input type="text" id="panNo" name="PanNo" class="input-small"><br />
				</div>
			</div>
			<div class="row">
				<div class="form-group">
					<label for="contactPerson">Contact Person:</label>
					<input type="text" id="contactPerson" name="ContactPerson" class="input-small"><br />
				</div>
				<div class="form-group">
					<label for="website">Website:</label>
					<input type="url" id="website" name="Website" class="input-small"><br />
				</div>
			</div>
			<div class="form-group form-group-flex">
				<input type="button" id="Save" value="Save" />
				<input type="button" id="Refresh" value="Refresh" />
			</div>
		</div>
	</form>
</body>
</html>












