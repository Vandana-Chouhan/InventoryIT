<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="FinancialYear" method="post">
		<div class="panel">
			<div class="header">
				<h4>Financial Year Details</h4>
				<input type="button" id="return-to-view" value="Return to View" />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="companyName">Financial Year From:</label>
				<input type="text" id="companyName" class="input-small" name="FinancialYearFrom" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="address">Financial Year To:</label>
				<input type="text" id="address" class="input-small" name="FinancialYearTo" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="companyShortName">Financial Year Name:</label>
				<input type="text" id="companyShortName" class="input-small" name="FinancialYearName" required><br />
			</div>
			<div class="form-group form-group-flex">
				<input type="button" id="Save" value="Save" />
				<input type="button" id="Refresh" value="Refresh" />
			</div>
		</div>
	</form>
</body>
</html>












