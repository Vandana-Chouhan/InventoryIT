<html>
<head>
	<link href="~/css/mastersetup.css" rel="stylesheet" />
</head>
<body>
	<form asp-action="AddCountry" method="post">
		<div class="panel">
			<div class="header">
				<h5>Country Details</h5>
				<input type="button" id="return-to-view" value="Return to View" />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="CountryName">Country Name:</label>
				<input type="text" id="CountryName" class="input-small" name="CountryName" required><br />
			</div>
			<div class="form-group">
				<span class="required">*</span><label for="CountryShortName">Country Short Name:</label>
				<input type="text" id="CountryShortName" class="input-small" name="CountryShortName" required><br />
			</div>
			<div class="form-group form-group-flex">
				<input type="submit" id="Save" value="Save" />
				<input type="button" id="Refresh" value="Refresh" />
			</div>
		</div>
	</form>
</body>
</html>