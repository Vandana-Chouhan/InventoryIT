<html>
<head>
	<link href="~/Company/style.css" rel="stylesheet" />
</head>
<body>
	<div class="container mt-4">
		<div class="car">
			<div class="card-heade text-white d-flex justify-content-between" style="border-radius:5px;height:42px;">
				<h4 style="font-size: 20px;
                font-weight: bold;">
					COUNTRY DETAILS
				</h4>
				<a href="/CompanyMaster/Index" style="background-color:#f8f9fa;color:black; background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">
					RETURN TO VIEW
				</a>
			</div>
		<div class="card-body">
			<form asp-action="AddFCountry" asp-controller="MastCountry" method="post" style="background-color: white;">
				<div class="row mb-2">
					<label class="col-sm-4 col-form-label text-end">Country Name:</label>
					<div class="col-sm-6">
						<input type="text" id="CountryName" class="form-control" name="CountryName" required><br />
					</div>
				</div>
				<div class="row mb-2">
					<label class="col-sm-4 col-form-label text-end">Country  Short Name:</label>
					<div class="col-sm-6">
						<input type="text" id="CountryShortName" class="form-control" name="CountryShortName" required><br />
					</div>
				</div>
				<div class="text-center mt-3">
					<button type="submit" class="btn btn-success"><i class="bi bi-house-add-fill"></i>Save</button>
					<button type="reset" class="btn btn-primary"><i class="bi bi-arrow-clockwise"></i>Refresh</button>
				</div>
			</form>
		</div>
	</div>
	</div>
</body>
</html>