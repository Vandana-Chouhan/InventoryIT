
<html>
<head>
	<!-- Toastr CSS -->
	@* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"> *@
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<link href="~/css/countrystatecity.css" rel="stylesheet" />

</head>
<body>
	<div class="container mt-4">
		<div class="card shadow p-3">
			<div class="card-header text-white d-flex justify-content-between align-items-center">
				<h4 class="mb-0">COUNTRY DETAILS</h4>
				<a href="/MastCountry/CountryDataTab" class="btn btn-light btn-sm fw-bold" style="background-color: black;
               color: #f6f9ff;
               font-size: 14px;
               font-weight: bold;
               padding: 5px;">RETURN TO VIEW</a>
			</div>
			<div class="card-body">
				<form asp-action="AddCountry" asp-controller="MastCountry" method="post" id="countryForm" class="d-flex flex-column align-items-center">

					<div class="col-md-8">
						<div class="row mb-2">
							<label class="col-sm-4 col-form-label text-end">Country Name:</label>
							<div class="col-sm-8">
								<input type="text" id="CountryName" class="form-control" name="CountryName" required>
							</div>
						</div>
						<div class="row mb-3">
							<label class="col-sm-4 col-form-label text-end">Country Short Name:</label>
							<div class="col-sm-8">
								<input type="text" class="form-control" name="CountryShortName" id="CountryShortName" required>
							</div>
						</div>
					</div>

					<div class="text-center mt-3">
						<button type="submit" class="btn btn-success equal-width-btn"><i class="bi bi-house-add-fill"></i> Save</button>
						<button type="reset" class="btn btn-primary equal-width-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- jQuery and Toastr JS -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

	<!-- Toastr Notification Script -->
	@* <script>
		$(document).ready(function () {
			var message = "@TempData["SuccessMessage"]";
			if (message) {
				toastr.options = {
					"closeButton": true,
					"progressBar": true,
					"positionClass": "toast-top-right", // ✅ Left bottom corner par message
					"timeOut": "10000",
					"extendedTimeOut": "10000"
				};
				toastr.success(message);
			}
		});
	</script> *@

	<script>
		document.getElementById("countryForm").addEventListener("submit", function (event) {
			event.preventDefault();
			Swal.fire({
				title: "Are you sure?",
				text: "Create this Country!",
				icon: "warning",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, Create it!"
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: "Created!",
						text: "Your file has been Created.",
						icon: "success"
					}).then(() => {
						document.getElementById("countryForm").reset();
					});
				}
			});

		});
	</script>
</body>

</html> 

